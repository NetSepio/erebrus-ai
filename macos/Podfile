platform :osx, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)

    # Xcode 26 may select its downloadable Metal toolchain as the primary
    # linker toolchain. That asset intentionally has no usr/lib/swift/macosx
    # directory, so every CocoaPods target emits the same missing search-path
    # warning. The bundled default toolchain still provides the Metal compiler
    # and contains the Swift libraries used while linking macOS targets.
    target.build_configurations.each do |configuration|
      configuration.build_settings[
        'TOOLCHAINS'
      ] = 'com.apple.dt.toolchain.XcodeDefault'
    end

    # whisper_ggml_plus 1.5.2 globally includes ARM kernels and excludes x86
    # kernels even though macOS pods are universal. Correct the source set per
    # architecture so both Apple-silicon and Intel releases link.
    if target.name == 'whisper_ggml_plus'
      x86_root = File.expand_path(
        File.join(
          'Flutter', 'ephemeral', '.symlinks', 'plugins',
          'whisper_ggml_plus', 'macos', 'Classes', 'whisper', 'ggml',
          'src', 'ggml-cpu', 'arch', 'x86'
        ),
        __dir__
      )
      ['quants.c', 'repack.cpp'].each do |filename|
        reference = installer.pods_project.new_file(
          File.join(x86_root, filename)
        )
        target.source_build_phase.add_file_reference(reference, true)
      end
      target.build_configurations.each do |configuration|
        configuration.build_settings[
          'EXCLUDED_SOURCE_FILE_NAMES[arch=x86_64]'
        ] = '*/ggml-cpu/arch/arm/*'
        configuration.build_settings[
          'EXCLUDED_SOURCE_FILE_NAMES[arch=arm64]'
        ] = '*/ggml-cpu/arch/x86/*'
      end
    end
  end
end
