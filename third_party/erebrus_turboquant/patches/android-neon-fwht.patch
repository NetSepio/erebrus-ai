+static void turbo_cpu_apply_signs(float * x, const float * signs, float scale, int group_size) {
+    int i = 0;
+#if defined(__ARM_NEON) && defined(__aarch64__)
+    const float32x4_t scale_v = vdupq_n_f32(scale);
+    for (; i + 4 <= group_size; i += 4) {
+        const float32x4_t values_v = vld1q_f32(x + i);
+        const float32x4_t signs_v = vld1q_f32(signs + i);
+        vst1q_f32(x + i, vmulq_f32(values_v, vmulq_f32(signs_v, scale_v)));
+    }
+#endif
+    for (; i < group_size; i++) {
+        x[i] *= signs[i] * scale;
+    }
+}
+
+static void turbo_cpu_fwht_butterflies(float * x, int group_size) {
+    for (int h = 1; h < group_size; h *= 2) {
+        for (int i = 0; i < group_size; i += h * 2) {
+            int j = i;
+#if defined(__ARM_NEON) && defined(__aarch64__)
+            for (; j + 4 <= i + h; j += 4) {
+                const float32x4_t a = vld1q_f32(x + j);
+                const float32x4_t b = vld1q_f32(x + j + h);
+                vst1q_f32(x + j, vaddq_f32(a, b));
+                vst1q_f32(x + j + h, vsubq_f32(a, b));
+            }
+#endif
+            for (; j < i + h; j++) {
+                const float a = x[j];
+                const float b = x[j + h];
+                x[j] = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+}
+
