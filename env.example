# Copy this file to .env in the project root and fill in the values.
# The .env file is bundled as an asset and parsed by RuntimeConfig at startup.
# --dart-define values always override these.

REOWN_PROJECT_ID=
EREBRUS_WEB_ORIGIN=https://erebrus.io
GOOGLE_SERVER_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=https://gateway.erebrus.io/api/v2/auth/apple/callback
GATEWAY_URL=https://gateway.erebrus.io
